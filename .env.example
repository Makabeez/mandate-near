# Copy to .env and fill in. .env is git-ignored.

# --- NEAR -------------------------------------------------------------
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# Your testnet account. Its key is read from ~/.near-credentials/testnet/<id>.json
# (near-cli-rs "save-to-legacy-keychain"), or set OWNER_PRIVATE_KEY=ed25519:...
OWNER_ACCOUNT_ID=
# OWNER_PRIVATE_KEY=

# Vault = <VAULT_PREFIX>.<OWNER_ACCOUNT_ID>. Change the prefix to deploy a fresh one.
VAULT_PREFIX=mandate
VAULT_FUND=4.5

# --- NEAR AI Cloud (the agent's model) ------------------------------
# cloud.near.ai -> API keys. $10 free credits via https://nearbuilders.org/join
NEAR_AI_API_KEY=
# NEAR-hosted models run in TEEs and sign their responses. List: curl https://cloud-api.near.ai/v1/models
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# --- Agent / red-team server ------------------------------------------
BUSINESS_NAME=Makabeez Labs
INVOICE_SCALE=0.25
PORT=8097
# Public URL of the red-team API (your tunnel). Written into web/config.json by `npm run deploy`.
PUBLIC_API_URL=
CORS_ORIGIN=*
